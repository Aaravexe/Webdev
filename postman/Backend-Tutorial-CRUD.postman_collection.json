{
  "info": {
    "name": "Intro to Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"aarav\",\n  \"email\": \"aarav@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/users/register"
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/users/login"
      }
    },
    {
      "name": "Logout User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav@example.com\"\n}" },
        "url": "{{baseUrl}}/users/logout"
      }
    },
    {
      "name": "Create Post",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav\",\n  \"description\": \"First post created with Postman\",\n  \"age\": 20\n}" },
        "url": "{{baseUrl}}/posts/create"
      }
    },
    { "name": "Get Posts", "request": { "method": "GET", "url": "{{baseUrl}}/posts/getPosts" } },
    {
      "name": "Update Post",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated through Postman\",\n  \"age\": 21\n}" },
        "url": "{{baseUrl}}/posts/update/{{postId}}"
      }
    },
    { "name": "Delete Post", "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/delete/{{postId}}" } }
  ]
}

{
  "info": { "name": "Backend Tutorial CRUD", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000/api/v1" }, { "key": "token", "value": "" }, { "key": "postId", "value": "" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav\",\n  \"email\": \"aarav@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/register" } },
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/login" } },
    { "name": "Create Post", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"This is a post created through the CRUD API.\"\n}" }, "url": "{{baseUrl}}/posts" } },
    { "name": "Get Posts", "request": { "method": "GET", "url": "{{baseUrl}}/posts" } },
    { "name": "Update Post", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated post title\"\n}" }, "url": "{{baseUrl}}/posts/{{postId}}" } },
    { "name": "Delete Post", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/posts/{{postId}}" } }
  ]
}
